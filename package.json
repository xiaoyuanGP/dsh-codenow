{
  "name": "dsh-codenow",
  "version": "0.4.0",
  "private": true,
  "description": "多角色 AI 协同工作台：17 个岗位模板、群聊回放、团队任务与各 agent 用量/缓存，并把编排能力作为 codenow 工具交给 Lead；内置 Blender 建模用的技能、MCP 桥与 addon。",
  "icon": "icon.svg",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/",
    "cordis.patch.yml",
    "icon.svg",
    "bin/",
    "NOTICES.md",
    "assets/roles/*.md",
    "assets/skills/",
    "assets/blender-addon/"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-connection"
      ]
    }
  }
}
